rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can access only their own MayerDistribution data.
    match /users/{userId}/appData/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/programs/{programId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/syncMeta/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for every path not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
